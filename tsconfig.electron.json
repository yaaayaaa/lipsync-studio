{
  "compilerOptions": {
    "tsBuildInfoFile": "./dist-electron/.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "noEmit": false,
    "composite": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["electron"]
}
