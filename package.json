{
  "name": "lipsync-studio",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests electron",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "electron:start": "npm run build && npm run electron:build && electron .",
    "electron:dev": "npm run electron:build && ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "dist:mac": "scripts/dist-mac.sh --publish never",
    "dist:win": "npm run build && npm run electron:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ag-psd": "^31.0.3",
    "dockview-react": "8.4.1",
    "electron": "43.7.9",
    "electron-builder": "26.17.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.52.0",
    "mediabunny": "^1.61.6",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dockview-core": "8.4.1",
    "dockview": "8.4.1"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
